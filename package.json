{
  "name": "my-playwright-project",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright TypeScript API and responsive UI testing with Page Object Model",
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api-tests",
    "test:desktop": "playwright test --project=chromium-desktop",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:mobile:safari": "playwright test --project=mobile-safari",
    "test:ui": "playwright test --project=chromium-desktop --project=mobile-chrome --project=mobile-safari",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5"
  }
}